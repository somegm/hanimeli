MONGODB_URI=mongodb://localhost:27017/hanimeli
PORT=3000
JWT_SECRET=your-secret-key-here

# marketfiyati.org.tr konum ayarları (Ankara varsayılan)
MARKET_LATITUDE=39.97041
MARKET_LONGITUDE=32.85647
MARKET_DISTANCE=50000

# Otomatik fiyat senkron aralığı (ms) — 6 saat = 21600000
MARKET_SYNC_INTERVAL_MS=21600000

# İndirim tarama ayarları
MARKET_MAX_DISCOUNTS=500
MARKET_DISCOUNT_SEARCH_PAGES=2
MARKET_DISCOUNT_SEARCH_SIZE=30

# Dolap tarif önerisi — Google AI Studio'dan ücretsiz anahtar alın
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Alternatif: OpenAI (GEMINI_API_KEY yoksa kullanılır)
# OPENAI_API_KEY=your-openai-api-key-here
